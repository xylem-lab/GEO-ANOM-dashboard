# Data directories (large files)
data/raw/
data/processed/*.gpkg
data/processed/*.npz
*.tif
*.tiff

# Experimental/derived detection outputs -- large (pixel-level, unsimplified
# polygon boundaries), regenerable by rerunning the script named in the
# filename, not referenced by anything else. The canonical
# full_registry_unet_tulbure_detections.geojson stays tracked.
data/processed/detections/experimental_*.geojson
data/processed/detections/*_v2.geojson
data/processed/detections/*_task1_scoped.geojson

# BUT keep essential processed data for dashboard
!data/processed/scenarios/
!data/processed/*.csv
!data/processed/*.txt
!data/processed/*.md

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Model weights
*.pt
*.pth
*.onnx

# Rendered field/audit screenshots (regenerable by scripts/render_*_screenshots*.py)
data/processed/field_screenshots/
data/processed/species_audit_screenshots/

# Task 1 pipeline (scripts/map_buildings.py) -- per-candidate output is large
# and regenerable; buildings/farms/supply/run_meta stay tracked.
data/processed/task1/*/candidates.geojson
data/processed/task1/*/tiles/
data/processed/*.log
# Notebook scratch output (KMZs, personal audit sheets)
notebooks/output/
.ipynb_checkpoints/
data/processed/task1/*/supply_by_building.geojson
