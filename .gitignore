# Data directories (large files)
data/raw/
data/processed/*.gpkg
data/processed/*.npz
*.tif
*.tiff

# Experimental/derived detection outputs -- large (pixel-level, unsimplified
# polygon boundaries), regenerable by rerunning the script named in the
# filename, not referenced by anything else. The canonical
# full_registry_unet_tulbure_detections.geojson stays tracked.
data/processed/detections/experimental_*.geojson
data/processed/detections/*_v2.geojson
data/processed/detections/*_task1_scoped.geojson

# BUT keep essential processed data for dashboard
!data/processed/scenarios/
!data/processed/*.csv
!data/processed/*.txt
!data/processed/*.md

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Model weights
*.pt
*.pth
*.onnx
data/processed/detections/full_registry_unet_tulbure_detections_task1_scoped.geojson
